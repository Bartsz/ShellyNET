{
  "name": "shelly-rpc-metadata-generator",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "tsx src/generate.ts",
    "generate:aliases": "tsx src/generate-aliases.ts",
    "generate:metadata": "tsx src/generate-metadata.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:generated": "tsc --noEmit -p tsconfig.generated.json",
    "clean": "tsx src/clean.ts"
  },
 
  "devDependencies": {
    "@taulfsime/shelly-rpc-ts": "0.8.0",
    "@types/node": "25.0.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}