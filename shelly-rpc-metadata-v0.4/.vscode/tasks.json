{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Shelly: install dependencies",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "Shelly: generate compact metadata",
      "type": "npm",
      "script": "generate",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$tsc"
    },
    {
      "label": "Shelly: generate aliases",
      "type": "npm",
      "script": "generate:aliases",
      "problemMatcher": "$tsc"
    },
    {
      "label": "Shelly: generate metadata only",
      "type": "npm",
      "script": "generate:metadata",
      "problemMatcher": "$tsc"
    },
    {
      "label": "Shelly: typecheck generator",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": "$tsc"
    },
    {
      "label": "Shelly: typecheck generated aliases",
      "type": "npm",
      "script": "typecheck:generated",
      "problemMatcher": "$tsc"
    },
    {
      "label": "Shelly: clean generated files",
      "type": "npm",
      "script": "clean",
      "problemMatcher": []
    }
  ]
}
