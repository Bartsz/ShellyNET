{
  "name": "shelly-rpc-metadata-generator",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "tsx src/generate.ts",
    "generate:aliases": "tsx src/generate-aliases.ts",
    "generate:schema": "tsx src/generate-schema.ts",
    "generate:manifest": "tsx src/generate-manifest.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "tsx src/clean.ts",
    "typecheck:generated": "tsc --noEmit -p tsconfig.schema.json"
  },
  "devDependencies": {
    "@taulfsime/shelly-rpc-ts": "0.8.0",
    "@types/node": "25.0.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
